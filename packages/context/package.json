{
  "name": "@tiny_tools_pw/context",
  "version": "0.1.1",
  "description": "MCP server (Model Context Protocol) for AI coding agents: outline, search, slice and SQL-query PDF, DOCX, PPTX, XLSX, CSV, Parquet and log files without reading whole files. 8 tools, CLI included. Local-first, no telemetry.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "modelcontextprotocol",
    "ai-agents",
    "agent",
    "claude",
    "claude-code",
    "cursor",
    "codex",
    "copilot",
    "tokens",
    "token-savings",
    "context-window",
    "context",
    "local-first",
    "privacy",
    "pdf",
    "docx",
    "xlsx",
    "pptx",
    "csv",
    "parquet",
    "sql",
    "duckdb",
    "logs",
    "diff",
    "validate",
    "document-search",
    "spreadsheet"
  ],
  "bin": {
    "tiny-context": "./dist/cli.js",
    "tiny-context-mcp": "./dist/mcp.js",
    "tiny-context-read-guard": "./hooks/read-guard.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "hooks"
  ],
  "mcpName": "io.github.Warddamn/tiny-context",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.17.0",
    "commander": "^15.0.0",
    "fast-xml-parser": "^5.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.0.0",
    "@tiny_tools_pw/shared": "^0.1.1"
  },
  "optionalDependencies": {
    "@duckdb/node-api": "1.5.5-r.5"
  },
  "author": "AVRG3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepack": "node ../../scripts/sign.mjs --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Warddamn/tiny-tools.git",
    "directory": "packages/context"
  },
  "homepage": "https://github.com/Warddamn/tiny-tools/tree/main/packages/context#readme",
  "bugs": {
    "url": "https://github.com/Warddamn/tiny-tools/issues"
  }
}
