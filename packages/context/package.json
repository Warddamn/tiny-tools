{
  "name": "@tinytools/context",
  "version": "0.1.0",
  "description": "Token-saver toolkit for AI agents: know things about files without reading them. file_map \u00b7 query_file \u00b7 read_section \u00b7 query_table \u00b7 summarize_log \u00b7 diff_files \u00b7 validate_file \u00b7 extract. CLI + MCP server (stdio).",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "mcp",
    "mcp-server",
    "agent",
    "tokens",
    "context",
    "duckdb",
    "pdf",
    "docx",
    "xlsx",
    "pptx",
    "logs",
    "diff",
    "validate"
  ],
  "bin": {
    "tiny-context": "./dist/cli.js",
    "tiny-context-mcp": "./dist/mcp.js",
    "tiny-context-read-guard": "./hooks/read-guard.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "hooks"
  ],
  "mcpName": "io.github.avrg3/tiny-context",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tinytools/shared": "^0.1.0",
    "ajv": "^8.17.0",
    "commander": "^15.0.0",
    "fast-xml-parser": "^5.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.0.0"
  },
  "optionalDependencies": {
    "@duckdb/node-api": "1.5.5-r.5"
  },
  "author": "AVRG3"
}
