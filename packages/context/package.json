{
  "name": "@tinytools/context",
  "version": "0.1.0",
  "description": "Token-saver toolkit for AI agents: know things about files without reading them. file_map · query_file · read_section · query_table · summarize_log · diff_files · validate_file · extract. CLI + MCP server (stdio).",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "mcp",
    "mcp-server",
    "agent",
    "tokens",
    "context",
    "duckdb",
    "pdf",
    "docx",
    "xlsx",
    "pptx",
    "logs",
    "diff",
    "validate"
  ],
  "bin": {
    "tiny-context": "./dist/cli.js",
    "tiny-context-mcp": "./dist/mcp.js",
    "tiny-context-read-guard": "./hooks/read-guard.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "hooks"
  ],
  "mcpName": "io.github.warddamn/tiny-context",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.17.0",
    "commander": "^15.0.0",
    "fast-xml-parser": "^5.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.0.0",
    "@tinytools/shared": "^0.1.0"
  },
  "optionalDependencies": {
    "@duckdb/node-api": "1.5.5-r.5"
  },
  "author": "AVRG3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepack": "node ../../scripts/sign.mjs --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Warddamn/tiny-tools.git",
    "directory": "packages/context"
  },
  "homepage": "https://github.com/Warddamn/tiny-tools/tree/main/packages/context#readme",
  "bugs": {
    "url": "https://github.com/Warddamn/tiny-tools/issues"
  }
}
