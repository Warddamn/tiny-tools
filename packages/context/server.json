{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.OWNER/tiny-context",
  "description": "Know things about files without reading them: outline, ranked search, surgical reads, SQL over CSV/XLSX/Parquet, log clustering, diffs, validation, extraction — incl. PDF/DOCX/PPTX/XLSX. Local-first, bounded responses, savings line on every call.",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/OWNER/tiny-tools",
    "source": "github",
    "subfolder": "packages/context"
  },
  "websiteUrl": "https://github.com/OWNER/tiny-tools/tree/main/packages/context#readme",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@tinytools/context",
      "version": "0.1.0",
      "transport": { "type": "stdio" },
      "runtimeHint": "npx",
      "runtimeArguments": [
        { "type": "positional", "value": "-y", "isRequired": true },
        { "type": "positional", "value": "-p", "isRequired": true },
        { "type": "positional", "value": "@tinytools/context", "isRequired": true },
        { "type": "positional", "value": "tiny-context-mcp", "isRequired": true }
      ],
      "environmentVariables": [
        { "name": "TINY_TOOLS_DEBUG", "description": "Set to 1 to log each call to stderr.", "isRequired": false, "isSecret": false, "default": "0" }
      ]
    }
  ]
}
