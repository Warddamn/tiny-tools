{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.warddamn/tiny-context",
  "title": "tiny-context",
  "description": "Outline, search, SQL-query, diff, validate PDF/DOCX/PPTX/XLSX/CSV/logs without reading whole files",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/Warddamn/tiny-tools",
    "source": "github",
    "subfolder": "packages/context"
  },
  "websiteUrl": "https://github.com/Warddamn/tiny-tools/tree/main/packages/context#readme",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@tinytools/context",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "-y",
          "isRequired": true
        },
        {
          "type": "positional",
          "value": "-p",
          "isRequired": true
        },
        {
          "type": "positional",
          "value": "@tinytools/context",
          "isRequired": true
        },
        {
          "type": "positional",
          "value": "tiny-context-mcp",
          "isRequired": true
        }
      ],
      "environmentVariables": [
        {
          "name": "TINY_TOOLS_DEBUG",
          "description": "Set to 1 to log each call to stderr.",
          "isRequired": false,
          "isSecret": false,
          "default": "0"
        }
      ]
    }
  ]
}
