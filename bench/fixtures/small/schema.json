{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "name",
    "version",
    "targets"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "retries": {
      "type": "integer",
      "minimum": 0
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "dpi"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "dpi": {
            "type": "integer"
          }
        }
      }
    }
  }
}