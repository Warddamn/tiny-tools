{
  "name": "tiny-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Small, local-first tools that AI agents install with one config line. Core library \u2192 CLI \u2192 MCP server, from one codebase.",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "bench",
    "evals"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo bench/dist bench/*.tsbuildinfo evals/dist evals/*.tsbuildinfo",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run",
    "bench:fixtures": "npm run build && node bench/dist/fixtures.js",
    "bench": "npm run build && node bench/dist/run.js",
    "evals": "npm run build && node evals/dist/run.js",
    "pretest": "node scripts/sign.mjs --check",
    "sign": "node scripts/sign.mjs",
    "stats": "node scripts/stats.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "bundle:mcpb": "npm run build && node scripts/build-mcpb.mjs",
    "verify:mcpb": "node scripts/verify-mcpb.mjs",
    "bench:runtime": "npm run build && node scripts/bench-runtime.mjs",
    "demo:runtime": "npm run build && node packages/runtime/examples/demo.mjs",
    "verify:runtime": "npm run build && node scripts/verify-runtime-install.mjs",
    "evals:runtime": "npm run build && node scripts/eval-runtime.mjs",
    "bundle:runtime": "npm run build && node scripts/build-runtime-release.mjs",
    "verify:runtime:bundle": "node scripts/verify-runtime-bundle.mjs",
    "verify:runtime:public": "node scripts/verify-runtime-public.mjs",
    "bundle:context": "npm run build && node scripts/build-context-release.mjs",
    "bench:safety": "npm run build && node scripts/bench-safety.mjs"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4",
    "typescript": "^5.9",
    "vitest": "^5"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "AVRG3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Warddamn/tiny-tools.git"
  },
  "homepage": "https://github.com/Warddamn/tiny-tools#readme",
  "bugs": {
    "url": "https://github.com/Warddamn/tiny-tools/issues"
  }
}
